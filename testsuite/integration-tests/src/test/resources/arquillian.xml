<arquillian xmlns="http://jboss.org/schema/arquillian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://jboss.org/schema/arquillian
        http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
    <defaultProtocol type="Servlet 5.0" />
    <container qualifier="wildfly" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home}</property>
            <property name="serverConfig">${jboss.server.config.file.name:standalone-full.xml}</property>
            <property name="javaVmArguments">${debugJvmArgs} -server -Xms256m -Xmx1G -Dmaven.repo.local=${settings.localRepository} -Djboss.bind.address=${node} -Djboss.bind.address.management=${node} -Dnode=${node} -Dipv6=${ipv6} ${additionalJvmArgs} ${wildfly.system.properties} ${ipv6ArquillianSettings} ${jacoco.agent} -Djboss.socket.binding.port-offset=${container.offset.managed}
            </property>
            <property name="managementAddress">${node}</property>
            <property name="managementPort">${container.management.port.managed}</property>
        </configuration>
    </container>
    <extension qualifier="systemproperties">
        <property name="prefix">org.jboss.resteasy.</property>
    </extension>
</arquillian>
